# Copy this file to .streamlit/secrets.toml and fill in your own key.
# Get a free Gemini API key from https://aistudio.google.com/apikey
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is already git-ignored — never commit your real key.

GEMINI_API_KEY = "your-gemini-api-key-here"
